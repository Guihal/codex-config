{
  "description": "Stateful Codex port of the Pi injection-rules lifecycle.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/injection-rules.mjs\"",
          "timeout": 5,
          "statusMessage": "Loading Codex rules",
          "additionalContextLimit": 24000
        }]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/injection-rules.mjs\"",
          "timeout": 5,
          "statusMessage": "Loading Codex role rules",
          "additionalContextLimit": 24000
        }]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/injection-rules.mjs\"",
          "timeout": 5,
          "statusMessage": "Refreshing Codex rules",
          "additionalContextLimit": 24000
        }]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery",
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/injection-rules.mjs\"",
          "timeout": 5,
          "statusMessage": "Tracking rule context"
        }]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/lint-inject.mjs\"",
          "timeout": 25,
          "statusMessage": "Linting changed files",
          "additionalContextLimit": 5000
        }]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/injection-rules.mjs\"",
          "timeout": 5,
          "statusMessage": "Scheduling Codex reminders"
        }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"${PLUGIN_ROOT}/scripts/injection-rules.mjs\"",
          "timeout": 5,
          "statusMessage": "Scheduling role reminders"
        }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/runtime-guards.py\"",
            "timeout": 10,
            "statusMessage": "Checking process targets and skill recovery",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
