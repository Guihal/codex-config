{
  "mcpServers": {
    "project-structure": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/project-tree-mcp.mjs"
      ],
      "cwd": ".",
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 15,
      "supports_parallel_tool_calls": true,
      "default_tools_approval_mode": "auto",
      "enabled_tools": [
        "project_tree"
      ]
    }
  }
}
