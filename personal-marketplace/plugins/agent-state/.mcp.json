{
  "mcpServers": {
    "agent-state": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./scripts/agent-state-mcp.mjs"
      ],
      "cwd": ".",
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 10,
      "supports_parallel_tool_calls": false,
      "default_tools_approval_mode": "auto",
      "enabled_tools": [
        "agent_state_note",
        "agent_state_checkpoint",
        "agent_state_history",
        "agent_state_read"
      ],
      "env_vars": [
        "CODEX_HOME",
        "XDG_STATE_HOME",
        "CODEX_AGENT_STATE_STATE_DIR"
      ]
    }
  }
}
